{
  "enabled": true,
  "wizard_title": "流式语音识别快速配置",
  "swcap_to_model": {
    "swcap_audio_asr": { "npu_index": [0], "model_id": "qwen3-asr" }
  },
  "upload_endpoint": "/api/qwen3-asr/upload",
  "start_buttons": ["asr-start-btn"],

  "open_source_button": "asr-open",
  "canvas_id": "asr-preview-wrap",
  "open_source_label": "预览播放",
  "drop_hint": "或点击「浏览」选择音频或视频",
  "drop_icon": "<svg viewBox=\"0 0 24 24\" width=\"48\" height=\"48\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M4 10v4\"/><path d=\"M8 7v10\"/><path d=\"M12 4v16\"/><path d=\"M16 7v10\"/><path d=\"M20 10v4\"/></svg>",

  "steps": [
    { "id": "env",    "title": "运行环境检查", "kind": "env_check" },
    { "id": "source", "title": "音频源",       "kind": "form",
      "fields": [
        { "id": "asr-source", "ui_key": "source",
          "label": "音频文件或含音轨的视频（设备端路径；也可在本机上传。支持 wav / mp3 / m4a / flac / ogg 与含音轨的视频）",
          "type": "text", "required": true,
          "placeholder": "例：/userdata/assets/uploads/asr_en.wav" },
        { "id": "asr-mode", "ui_key": "mode", "label": "显示模式", "type": "select",
          "options": [
            { "value": "single", "label": "实时结果（文字实时刷新，蓝色是还可能改动的部分）", "selected": true },
            { "value": "rounds", "label": "识别过程（每识别一小段就记一行，能看到文字是怎么一步步成句的）" }
          ] }
      ] },
    { "id": "translate", "title": "实时翻译（可选）", "kind": "form",
      "fields": [
        { "id": "asr-tr-target", "ui_key": "trTarget",
          "label": "翻译目标语言（选「不翻译」就不加载翻译模型；选了会额外加载翻译模型，与识别模型共用同一张计算卡，约占 2.2 GB）",
          "summary_label": "翻译目标语言",
          "type": "select",
          "options": [
            { "value": "off", "label": "不翻译", "selected": true }
          ] }
      ] },
    { "id": "dub", "title": "配音导出（可选）", "kind": "form",
      "fields": [
        { "id": "asr-dub-voice", "ui_key": "dubVoice",
          "label": "配音音色（生成配音版时用；本板只有参考音色能出声）",
          "summary_label": "配音音色",
          "type": "select",
          "options": [] }
      ] },
    { "id": "finish", "title": "完成配置",     "kind": "finish" }
  ]
}
